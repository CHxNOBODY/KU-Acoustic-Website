PORT=3001
HOST=127.0.0.1
DATABASE_PATH=./data/club.sqlite
# Comma-separated frontend origins when deployed behind a proxy.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set a long, unique secret before using the admin dashboard.
ADMIN_TOKEN=
# Set to 1 only when a trusted reverse proxy sets X-Forwarded-For, so rate
# limiting keys on the visitor instead of the proxy.
TRUST_PROXY=0
